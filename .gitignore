# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow the placeholder env template
!.env.example

# supabase cli local state
supabase/.temp/
supabase/.branches/

# PDF.js worker and data files copied from node_modules (scripts/copy-pdfjs-assets.mjs)
/public/pdfjs/

# never commit database dumps, backups, test output or documents
*.dump
*.sql.gz
*.backup
*.pdf
test-output*
screenshots*
/supabase/snippets/
