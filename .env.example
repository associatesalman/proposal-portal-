# Copy to .env.local and fill in values locally. Never commit real credentials.

# Base URL of this app, used to build private client links (e.g. http://localhost:3000).
# Links built from a localhost/private address only work on this machine.
# Hosted staging: the staging HTTPS URL. NEXT_PUBLIC_* values are compiled into
# the build, so redeploy after changing them. See docs/HOSTED_STAGING_SETUP.md.
# Never put hosted values in your local .env.local.
NEXT_PUBLIC_APP_URL=

# Supabase project URL and publishable key (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY secret key (never prefix with NEXT_PUBLIC_). Local stack: the
# "Secret" key from `npx supabase status`. Hosted: Project Settings -> API Keys.
# Used by src/lib/supabase/privileged.ts to record verified PDF metadata,
# offer settings and link state (Phase 4), by the rate limiter and by
# scripts/storage-cleanup.mjs (Phase 7). Not used for dashboard CRUD.
SUPABASE_SECRET_KEY=

# Optional PDF limits (server-side; defaults shown). Upload size can't exceed
# the storage bucket limit (25 MiB). See docs/PHASE_4_SUMMARY.md.
# PDF_MAX_UPLOAD_MB=20
# PDF_MAX_PAGES=300
# (The same limits apply to DOCX, DOC, ODT, RTF and TXT uploads.)

# --- Document conversion (optional, server-only) ------------------------------
# PDF and plain-text (TXT) uploads always work. DOCX, DOC, ODT and RTF need
# headless LibreOffice on the SERVER that runs Next.js. Leave unset to keep
# those formats disabled (the dashboard says so). Not available on Vercel
# serverless functions. See docs/FEATURE_FULL_ACCESS_MULTIFORMAT.md.
# Absolute path of the soffice executable, e.g. /usr/bin/soffice or
# C:\Program Files\LibreOffice\program\soffice.exe
# LIBREOFFICE_PATH=
# Kill a conversion after this many milliseconds (default 60000, max 300000).
# DOCUMENT_CONVERSION_TIMEOUT_MS=60000
# Conversions running at once per server instance (default 1, max 8).
# DOCUMENT_CONVERSION_CONCURRENCY=1
# Tests only (never in production; refused on Vercel): a .mjs under
# supabase/tests/ that stands in for soffice.
# LIBREOFFICE_TEST_DOUBLE=

# --- Phase 7 (all optional, server-only) -------------------------------------
# Bounded waits on Supabase (milliseconds). See docs/PHASE_7_HARDENING_SUMMARY.md §7.
# SUPABASE_FETCH_TIMEOUT_MS=10000
# SUPABASE_AUTH_TIMEOUT_MS=6000
# Server-side Supabase address, if it differs from NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_SERVER_URL=

# Rate limiting (shared PostgreSQL limiter). See PHASE_7 §3.
# RATE_LIMIT_ENABLED=true
# HMAC key for limiter keys; defaults to a key derived from SUPABASE_SECRET_KEY.
# RATE_LIMIT_KEY_SECRET=
# PRODUCTION: tell the app how to find the real client address. Without one
# of these, X-Forwarded-For can be spoofed by clients.
#   Vercel:                     RATE_LIMIT_CLIENT_IP_HEADER=x-real-ip
#   Behind N appending proxies: RATE_LIMIT_TRUSTED_PROXY_HOPS=1
# RATE_LIMIT_CLIENT_IP_HEADER=
# RATE_LIMIT_TRUSTED_PROXY_HOPS=0
# Per-rule overrides as "<limit>/<window seconds>" (defaults shown):
# RATE_LIMIT_LOGIN_IP_EMAIL=10/900
# RATE_LIMIT_LOGIN_EMAIL=20/900
# RATE_LIMIT_LOGIN_IP=100/900
# RATE_LIMIT_LINK_PAGE_IP=120/60
# RATE_LIMIT_LINK_PREVIEW_IP=120/60
# RATE_LIMIT_LINK_PREVIEW_TOKEN=300/60
# RATE_LIMIT_LINK_MISS_IP=30/600
# RATE_LIMIT_UPLOAD_PREPARE_USER=30/600
# RATE_LIMIT_UPLOAD_COMPLETE_USER=30/600
# RATE_LIMIT_PREVIEW_GENERATE_USER=30/600
# RATE_LIMIT_PROPOSAL_DELETE_USER=30/600

# --- Hosted staging (server-only; see docs/HOSTED_STAGING_SETUP.md) ----------
# Scheduled storage cleanup (/api/cron/storage-cleanup, vercel.json). The
# endpoint is disabled (404) unless CRON_SECRET has 32+ characters. Vercel Cron
# sends it as "Authorization: Bearer <CRON_SECRET>". Dry run unless APPLY=true.
# CRON_SECRET=
# STORAGE_CLEANUP_CRON_APPLY=false
# STORAGE_CLEANUP_OLDER_THAN_HOURS=24

# --- Phase 8: payments (PayPal Checkout, Orders v2) -- all SERVER-ONLY --------
# Payments stay OFF unless PAYMENTS_ENABLED=true AND every required value below
# is valid. Never commit real values. See docs/PAYPAL_SETUP.md.
# PAYMENTS_ENABLED=false
# PAYPAL_ENVIRONMENT=sandbox            # sandbox | live
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=                 # secret
# PAYPAL_MERCHANT_ID=                   # expected payee (merchant account ID)
# PAYPAL_WEBHOOK_ID=                    # from the webhook registration
# Optional:
# PAYPAL_BRAND_NAME=
# PAYMENT_ACCESS_DAYS=180               # lifetime of a browser's paid access
# Tests only (loopback test double; refused for live and Vercel production):
# PAYPAL_API_BASE_URL=
#
# Access-recovery email (optional; without it the email form is hidden and
# Team Leads use the dashboard "Access link" instead):
# RECOVERY_EMAIL_PROVIDER=resend
# RESEND_API_KEY=                       # secret
# RECOVERY_EMAIL_FROM="Proposals <billing@example.com>"
# Tests only: RECOVERY_EMAIL_API_BASE_URL=
#
# Payment rate limits (defaults shown):
# RATE_LIMIT_CHECKOUT_IP=20/600
# RATE_LIMIT_CHECKOUT_TOKEN=30/600
# RATE_LIMIT_PURCHASE_IP=120/60
# RATE_LIMIT_PURCHASE_DOCUMENT_IP=60/60
# RATE_LIMIT_RECOVERY_IP=10/900
# RATE_LIMIT_RECOVERY_EMAIL=5/900
# RATE_LIMIT_RECOVERY_CLAIM_IP=20/900
# RATE_LIMIT_RECOVERY_ISSUE_USER=30/600
# RATE_LIMIT_WEBHOOK_IP=240/60
